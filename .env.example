# Production / deployed backend
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/analytico?retryWrites=true&w=majority
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
USE_MEMORY_DB=false
ANALYTICS_MODE=mock

# Optional — only if ANALYTICS_MODE=live (Instagram Business/Creator account required)
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Local dev without MongoDB: set USE_MEMORY_DB=true
