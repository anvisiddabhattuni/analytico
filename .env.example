# Production / deployed backend
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/analytico?retryWrites=true&w=majority
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000
USE_MEMORY_DB=false
ANALYTICS_MODE=mock

# GrowthBot — get key at console.anthropic.com
ANTHROPIC_API_KEY=

# Meta OAuth — get these at developers.facebook.com → Your App → Settings → Basic
# Required for real Instagram + Facebook analytics (ANALYTICS_MODE=live)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Must match an OAuth redirect URI registered in your Facebook App settings
META_REDIRECT_URI=http://localhost:5001/api/auth/meta/callback
# Frontend origin (used to redirect after OAuth callback)
FRONTEND_URL=http://localhost:3001

# Local dev: USE_MEMORY_DB=true persists users in analytico.db (SQLite, no MongoDB needed)
# SQLITE_DB_PATH=analytico.db   ← defaults to project root; override if needed
