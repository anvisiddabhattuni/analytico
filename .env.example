# Flask secrets
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# mock = demo data | live = real Meta Graph API (requires Meta OAuth below)
ANALYTICS_MODE=mock

# Database — leave DATABASE_URL unset to use local SQLite (analytico.db)
# DATABASE_URL=postgresql://user:password@host:5432/analytico
# SQLITE_DB_PATH=analytico.db

# GrowthBot — get key at console.anthropic.com
ANTHROPIC_API_KEY=

# Email (Resend) — used for verification emails
# RESEND_API_KEY=

# Meta OAuth — get these at developers.facebook.com → Your App → Settings → Basic
# Required for real Facebook Page analytics (ANALYTICS_MODE=live)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Must match an OAuth redirect URI registered in your Facebook App settings
META_REDIRECT_URI=http://localhost:5001/api/auth/meta/callback
# Frontend origin (used to redirect after OAuth callback)
FRONTEND_URL=http://localhost:3000
